---
# Rendered to group_vars/all/secrets.yml by scripts/configure.sh (mode 0600,
# gitignored). Copy manually only if you run ansible-playbook yourself.
#
# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
#   Reusable: yes (re-running the playbook must not need a new key)
#   Ephemeral: no  (an ephemeral node disappears when it goes offline)
#   Pre-approved: yes, so the host joins without manual approval
# Leave empty ("") to authenticate interactively instead — the tailscale role
# then prints a login URL for the user to open.
tailscale_auth_key: ""
