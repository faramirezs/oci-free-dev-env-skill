# devhost — .env
#
# Copy to .env and adjust. scripts/*.sh read this file; nothing here is
# committed to git (.gitignore). Every value below is a working default for a
# free-tier tenancy.

# --- Oracle Cloud ---------------------------------------------------------
# Leave empty to use the tenancy's home region (Always Free resources exist
# only there; preflight warns when this disagrees with the home region).
OCI_REGION=
# Compartment OCID. Empty = the tenancy root compartment.
OCID_COMPARTMENT=

# --- Host -----------------------------------------------------------------
DEVHOST_NAME=devhost-1        # instance name, hostname label, Tailscale node name
SSH_USER=ubuntu               # login user of the Ubuntu image
SSH_KEY_PATH=~/.ssh/id_ed25519

# --- Shape (Always Free allowance) ---------------------------------------
# Since 2026-06-15 the Always Free Ampere A1 allowance is 2 OCPU / 12 GB
# (1,500 OCPU-hours + 9,000 GB-hours per month). Tenancies created earlier may
# still show 4 OCPU / 24 GB in Limits, Quotas and Usage — check before raising
# these: anything over the allowance is billed on a pay-as-you-go account and
# refused on a free one.
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12

# Boot volume in GB. Counts against the 200 GB Always Free block-storage total
# (boot + block volumes combined). 47 GB is the minimum; 100 GB leaves room for
# a second instance or a backup.
BOOT_VOLUME_GB=100

# Ubuntu image version. The playbook asserts this version.
UBUNTU_VERSION=22.04

# --- Network --------------------------------------------------------------
VCN_CIDR=10.0.0.0/16
SUBNET_CIDR=10.0.0.0/24
# TCP/22 for the bootstrap phase. Empty = auto-detect this machine's public IP
# and allow only that /32. Never set 0.0.0.0/0: it exposes SSH to the internet
# from the first second. `configure.sh --tailscale-only` removes the rule again.
BOOTSTRAP_SSH_CIDR=

# --- Tailscale (primary access path) -------------------------------------
# https://login.tailscale.com/admin/settings/keys — create a key that is
# reusable and pre-approved (not ephemeral). Leave empty to authenticate
# interactively: the playbook then prints a login URL for the user to open.
TAILSCALE_AUTH_KEY=

# --- Optional public web --------------------------------------------------
# Only needed for caddy_public_sites with real DNS; opens 80/443 in ufw and the
# cloud NSG. The tailnet ingress on ports 9000-9009 needs neither.
EXPOSE_PUBLIC_HTTP=false
EXPOSE_PUBLIC_HTTPS=false
# YAML list, e.g. [{"domain":"app.example.com","upstream":"127.0.0.1:3000"}]
CADDY_PUBLIC_SITES=[]

# --- Capacity retry -------------------------------------------------------
# "Out of host capacity" is routine for A1 shapes in busy regions. The script
# cycles availability domains and retries; each attempt waits ATTEMPT_SLEEP
# seconds. MAX_ATTEMPTS=0 retries forever.
MAX_ATTEMPTS=24
ATTEMPT_SLEEP=60

# --- Escape hatches -------------------------------------------------------
# Extra arguments for every `oci` call, e.g. session-token auth:
# OCI_CLI_ARGS="--auth security_token --profile myprofile"
OCI_CLI_ARGS=
# PKG_INSTALL=0 makes preflight report missing tools instead of installing them.
PKG_INSTALL=1
